/* Write your T-SQL query statement below */
WITH cte AS (
    SELECT 
        tiv_2015, 
        tiv_2016, 
        COUNT(1) OVER (PARTITION BY lat, lon) AS locrank,
        COUNT(1) OVER (PARTITION BY tiv_2015) AS same2015
    FROM 
        Insurance
)
--SELECT * FROM cte
SELECT ROUND(SUM(tiv_2016), 2) AS tiv_2016 FROM CTE WHERE same2015 > 1 AND locrank = 1
--SELECT * FROM cte WHERE same2015 > 1